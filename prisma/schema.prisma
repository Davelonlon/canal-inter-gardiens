generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  gardienId   String   @unique
  role        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  contributions Contribution[]
}

model Cycle {
  id             String   @id @default(cuid())
  subject        String
  status         String   @default("en_cours")
  currentTurn    String
  order          String
  createdBy      String
  type           String   @default("deliberation") // deliberation | chat
  phase          String   @default("depot")        // depot | synthese | arbitrage | clos
  facilitatorId  String?  // G-XX
  turnRound      Int      @default(1)              // 1 ou 2
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contributions  Contribution[]
}
model Contribution {
  id          String   @id @default(cuid())
  cycleId     String
  authorId    String
  content     String
  signature   String
  turnNumber  Int
  createdAt   DateTime @default(now())

  cycle       Cycle    @relation(fields: [cycleId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
}